(defcfg
  process-unmapped-keys yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"))

(defsrc
  fn
       f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12

  caps
  a    s    d    f
  h    j    k    l    ;)

(defvar
  tap-time  200
  hold-time 500)

(deflayer base
  (layer-while-held fkeys)
  🔅   🔆    ✗    ✗    ✗    ✗    ◀◀   ▶⏸   ▶▶   🔇   🔉   🔊
  ;; tap caps → esc, hold caps → nav layer
  (tap-hold $tap-time $hold-time esc (layer-while-held nav))
  ;; home row mods (left): a s d f → shift ctrl alt cmd
  (tap-hold-press $tap-time $hold-time a lsft)
  (tap-hold-press $tap-time $hold-time s lctl)
  (tap-hold-press $tap-time $hold-time d lalt)
  (tap-hold-press $tap-time $hold-time f lmet)
  h
  ;; home row mods (right): j k l ; → cmd alt ctrl shift
  (tap-hold-press $tap-time $hold-time j rmet)
  (tap-hold-press $tap-time $hold-time k ralt)
  (tap-hold-press $tap-time $hold-time l rctl)
  (tap-hold-press $tap-time $hold-time ; rsft))

(deflayer fkeys
  _
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  f12
  _
  _    _    _    _
  _    _    _    _    _)

(deflayer nav
  _
  _    _    _    _    _    _    _    _    _    _    _    _
  _
  _    _    _    _
  left down up   rght _)
